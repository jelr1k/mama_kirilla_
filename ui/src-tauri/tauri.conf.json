{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Kirieshcka v2",
  "version": "2.0.0",
  "identifier": "com.kirieshcka.assistant",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5174",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Kirieshcka v2",
        "width": 1120,
        "height": 760,
        "minWidth": 940,
        "minHeight": 640,
        "center": true,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
